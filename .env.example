# 이 파일만 커밋한다. 실제 값은 각자 .env에 (git 제외, 키는 각자 계정). 값을 채팅·이슈에 붙이지 않는다.
# 환경마다 다른 값만 여기. 실험 값(모델, 하이퍼파라미터)은 experiments/<실험>/config.yaml에.
ANTHROPIC_API_KEY=
# 인용문헌 v5 검색의 Gemini 질의 임베딩.
GEMINI_API_KEY=
# 임베딩(벡터 검색)과 LLM 저지 채점. SDK가 환경 변수에서 읽는다 (core/llm/transport.py)
OPENAI_API_KEY=
# KIPRIS Plus Open API 키 (plus.kipris.or.kr 마이페이지 > APIKEY관리). 상품별 주소·키 파라미터는 #54 댓글: https://github.com/merge-mates/patent-ai-workspace/issues/54#issuecomment-7029188711
# 각자 신청: 데이터 신청 > Open API에서 상품마다 "무료(월 1,000건 제한)". 무제한 옵션·BULK는 유료라 담지 않는다
KIPRIS_PLUS_API_KEY=
# 법제처 국가법령정보 Open API 인증키(OC). 받기 스크립트(scripts/fetch_*.py)가 읽는다
LAW_OC=
# 외부 API 호출 상한. 아직 읽는 코드 없음 (KIPRIS 수집 모듈·월 예산 검사가 생기면 읽는다)
KIPRIS_PLUS_MONTHLY_CAP=1000   # 무료 옵션 월 호출 수 (초기화 날짜·초당 한도는 출처 확인 전, docs/assumptions.md 1번)
MODEL_MONTHLY_BUDGET_USD=30
# 포트·DB 계정을 바꿀 때만 (없으면 compose.yaml 기본값): POSTGRES_PASSWORD, DB_PORT, API_PORT, WEB_PORT
