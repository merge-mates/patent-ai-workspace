# 서버 개발용 이미지. 코드는 compose가 마운트하고 --reload로 다시 띄운다.
FROM python:3.14-slim
COPY --from=ghcr.io/astral-sh/uv:0.13 /uv /uvx /bin/
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY alembic.ini ./
COPY src ./src
RUN uv sync --frozen --no-dev
EXPOSE 8000
# 켜질 때마다 마이그레이션을 끝까지 올린 뒤 서버를 띄운다 (실패하면 서버도 안 뜸).
CMD ["sh", "-c", "uv run --no-sync alembic upgrade head && exec uv run --no-sync uvicorn patent_ai.api.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir src"]
